# Force LF line endings for files that are executed on Linux (the droplet).
# Without this, commits made on Windows ship .sh files with CRLF and the
# kernel can't parse `#!/bin/bash\r` — symptom is "scripts/foo.sh: not
# found" in cron logs (discovered 2026-05-19 during Phase 3 poll-cron
# bring-up).
*.sh text eol=lf
*.py text eol=lf

# The read-contract fixtures are byte copies of Pack'N OS's
# docs/contracts/fixtures/ and are pinned by checksum in
# tests/test_contract_fixtures.py (Phase 93, plan 22). LF in every checkout,
# so the bytes on disk are the bytes the OS wrote.
hubspot_ticket_automation/tests/fixtures/*.json text eol=lf
