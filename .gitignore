# Secrets — NEVER commit. Org-scoped ShipSidekick keys, HubSpot private-app
# token, Gmail OAuth token, action-ingest HMAC secret all live here.
hubspot_ticket_automation/config/.secrets/

# Per-run OS bundles and context files — they hold ticket text and are deleted after each run.
hubspot_ticket_automation/outputs/runs/os/

# Python bytecode / test caches
__pycache__/
*.pyc
.pytest_cache/

# Virtualenv (droplet uses .venv)
.venv/
